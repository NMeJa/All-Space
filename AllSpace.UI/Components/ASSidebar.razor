@using AllSpace.Domain.Interfaces
<MudPaper Class="sidebar" Elevation="0">
    <!-- Scrollable content area -->
    <div class="sidebar-scroll-container">
        <MudStack Spacing="2" AlignItems="AlignItems.Center" Class="pa-2 me-2">
            @foreach (var item in items)
            {
                switch (item)
                {
                    case WorkspaceFolder folder:
                        //IsExpanded is depended on the active folder id in case it uses the sidebar folder view
                        <ASFolderItem
                            Folder="@folder"
                            IsExpanded="@(expandedFolderId.Equals(folder.Id))"
                            OnFolderToggle="@HandleFolderToggle"
                            OnAppClick="@HandleAppClick"/>
                        break;
                    case Workspace workspace:
                        <ASItem Workspace="@workspace"
                                IsActive="@(workspace.Id.Equals(ActiveWorkspaceId))"
                                OnClick="@(() => HandleWorkspaceClick(workspace))"/>
                        break;
                }
            }
        </MudStack>
    </div>

    <!-- Fixed bottom content -->
    <MudStack Spacing="2" AlignItems="AlignItems.Center" Class="sidebar-bottom pa-2 me-2">
        <!-- Action Buttons -->
        <MudIconButton Icon="@Icons.Material.Filled.Add"
                       Class="action-button"
                       Size="Size.Large"
                       OnClick="@AddWorkspace"/>

        <MudIconButton Icon="@Icons.Material.Filled.Explore"
                       Class="action-button"
                       Size="Size.Large"
                       OnClick="@ExploreWorkspaces"/>

        <ASUserProfile/>
    </MudStack>
</MudPaper>

@code {

    // Input Parameters
    [Parameter] public List<WorkspaceFolder> Folders { get; set; } = new();
    [Parameter] public List<Workspace> Workspaces { get; set; } = new();
    [Parameter] public string? ActiveWorkspaceId { get; set; }

    // Event Callbacks
    [Parameter] public EventCallback<WorkspaceFolder> OnFolderClick { get; set; }
    [Parameter] public EventCallback<Workspace> OnWorkspaceClick { get; set; }
    [Parameter] public EventCallback<AppInfo> OnAppClick { get; set; }
    [Parameter] public EventCallback OnAddWorkspace { get; set; }
    [Parameter] public EventCallback OnExploreWorkspaces { get; set; }

    [Parameter] public EventCallback<WorkspaceFolder> OnSidebarFolderOpen { get; set; }

    private IOrderedEnumerable<ISidebarItem> items = Enumerable.Empty<ISidebarItem>().OrderBy(e => e.Order);

    private async Task HandleSidebarOpen(WorkspaceFolder folder)
    {
        // Handle opening a new sidebar view
        await OnSidebarFolderOpen.InvokeAsync(folder);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        items = Folders.Concat<ISidebarItem>(Workspaces)
                       .OrderByDescending(e => e.Order);
    }

    private string expandedFolderId = string.Empty;

    // Internal methods to handle clicks
    private async Task AddWorkspace()
    {
        await OnAddWorkspace.InvokeAsync();
    }

    private async Task ExploreWorkspaces()
    {
        await OnExploreWorkspaces.InvokeAsync();
    }

    private async Task HandleFolderToggle(WorkspaceFolder folder)
    {
        expandedFolderId = folder.Id;
        await OnFolderClick.InvokeAsync(folder);
    }

    private async Task HandleAppClick(AppInfo app)
    {
        // Invoke the app click callback
        await OnAppClick.InvokeAsync(app);

        // Optionally close the expanded folder after selecting an app
        // _expandedFolderId = null;
    }

    private async Task HandleWorkspaceClick(Workspace workspace)
    {
        await OnWorkspaceClick.InvokeAsync(workspace);
    }

}

<style>
    .sidebar {
        width: 80px;
        height: 100vh;
        background-color: #2b2d31;
        display: flex;
        flex-direction: column;
        position: relative;
    }

    .sidebar-scroll-container {
        flex: 1;
        overflow-y: auto;
        overflow-x: hidden;
        min-height: 0; /* Important for Firefox */
    }

    /* Custom scrollbar styling */
    .sidebar-scroll-container::-webkit-scrollbar {
        width: 4px;
    }

    .sidebar-scroll-container::-webkit-scrollbar-track {
        background: transparent;
    }

    .sidebar-scroll-container::-webkit-scrollbar-thumb {
        background: #1e1f22;
        border-radius: 2px;
    }

    .sidebar-scroll-container::-webkit-scrollbar-thumb:hover {
        background: #313338;
    }

    .sidebar-bottom {
        flex-shrink: 0;
        border-top: 1px solid #1e1f22;
        background-color: #2b2d31;
    }

    .action-button {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background-color: #1e1f22;
        color: #ffffff;
        flex-shrink: 0;
    }

    .action-button:hover {
        background-color: #313338;
        border-radius: 16px;
    }
</style>
