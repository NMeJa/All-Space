<MudPaper Class="sidebar" Elevation="0">
    <MudStack Spacing="2" AlignItems="AlignItems.Center" Class="pa-3">
        <!-- Workspace Folders -->
        @foreach (var folder in Folders)
        {
            <ASFolderItem Folder="@folder" OnClick="@(() => HandleFolderClick(folder))"/>
        }

        <!-- Divider -->
        <MudDivider Class="my-2" Style="width: 48px; background-color: #1e1f22;"/>

        <!-- Action Buttons -->
        <MudIconButton Icon="@Icons.Material.Filled.Add"
                       Class="action-button"
                       Size="Size.Large"
                       OnClick="@AddWorkspace"/>

        <MudIconButton Icon="@Icons.Material.Filled.Explore"
                       Class="action-button"
                       Size="Size.Large"
                       OnClick="@ExploreWorkspaces"/>

        <!-- Individual Workspace Items -->
        @foreach (var workspace in Workspaces)
        {
            <ASItem Workspace="@workspace"
                    IsActive="@(workspace.Id.Equals(ActiveWorkspaceId))"
                    OnClick="@(() => HandleWorkspaceClick(workspace))"/>
        }

        <!-- User Profile at Bottom -->
        <MudSpacer/>
        <ASUserProfile/>
    </MudStack>
</MudPaper>

@code {

    // Input Parameters
    [Parameter] public ImmutableList<WorkspaceFolder> Folders { get; set; } = ImmutableList<WorkspaceFolder>.Empty;
    [Parameter] public ImmutableList<WorkspaceInfo> Workspaces { get; set; } = ImmutableList<WorkspaceInfo>.Empty;
    [Parameter] public string? ActiveWorkspaceId { get; set; }

    // Event Callbacks
    [Parameter] public EventCallback<WorkspaceFolder> OnFolderClick { get; set; }
    [Parameter] public EventCallback<WorkspaceInfo> OnWorkspaceClick { get; set; }
    [Parameter] public EventCallback OnAddWorkspace { get; set; }
    [Parameter] public EventCallback OnExploreWorkspaces { get; set; }

    // Internal methods to handle clicks
    private async Task AddWorkspace()
    {
        await OnAddWorkspace.InvokeAsync();
    }

    private async Task ExploreWorkspaces()
    {
        await OnExploreWorkspaces.InvokeAsync();
    }

    private async Task HandleFolderClick(WorkspaceFolder folder)
    {
        await OnFolderClick.InvokeAsync(folder);
    }

    private async Task HandleWorkspaceClick(WorkspaceInfo workspace)
    {
        await OnWorkspaceClick.InvokeAsync(workspace);
    }

}

<style>
    .sidebar {
        width: 80px;
        height: 100vh;
        background-color: #2b2d31;
        display: flex;
        flex-direction: column;
    }

    .action-button {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background-color: #1e1f22;
        color: #ffffff;
    }

    .action-button:hover {
        background-color: #313338;
    }

</style>