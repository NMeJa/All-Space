@inject Data.Services.IIconService IconService
@switch (Folder.Type)
{
    case WorkspaceFolder.FolderType.DROPDOWN_COLLAPSABLE:
        <div>COL</div>
        break;
    case WorkspaceFolder.FolderType.DROPDOWN:
        <div>DRO</div>
        break;
    case WorkspaceFolder.FolderType.SIDEBAR:
    default:
        <div>SID</div>
        break;
}
<div class="folder-wrapper flex-shrink-0">
    @if (!isExpanded || Folder.Type == WorkspaceFolder.FolderType.SIDEBAR)
    {
        <!-- Collapsed folder view -->
        <MudContainer Class="ma-0" Fixed="true" Gutters="false">
            <MudButton OnClick="@HandleToggle" Class="pa-0 ma-0">
                <MudPaper Class="pa-2 folder-item" Elevation="0"
                          Width="55" Height="55">
                    @if (icon.Type != IconType.SystemDefault)
                    {
                        //TODO add the case when it is not svg but some other type which is not supported by MudIcon. In that case use MudImage
                        <AsyncIcon IconPath="@icon.Path"
                                   Class="folder-icon"
                                   Title="@Folder.Name"/>
                    }
                    else
                    {
                        <!-- Grid showing workspace icons -->
                        <div Class="folder-grid">
                            @foreach (var workspace in Workspaces.Take(4))
                            {
                                var wsIcon = workspace.GetIcon();
                                if (wsIcon.Type != IconType.SystemDefault)
                                {
                                    //TODO add the case when it is not svg but some other type which is not supported by MudIcon. In that case use MudImage
                                    <AsyncIcon IconPath="@icon.Path"
                                               Class="workspace-icon-mini"
                                               Title="@workspace.Name"/>
                                }
                                else
                                {
                                    <div class="workspace-placeholder"
                                         style="background-color: @workspace.BackgroundColor;">
                                        <span class="workspace-initial-mini">@workspace.Name[..1]</span>
                                    </div>
                                }
                            }
                        </div>
                    }
                </MudPaper>
            </MudButton>
        </MudContainer>
    }
    else if (Folder.Type is WorkspaceFolder.FolderType.DROPDOWN or
                            WorkspaceFolder.FolderType.DROPDOWN_COLLAPSABLE)
    {
        <!-- Expanded folder showing workspaces -->
        <MudPaper Class="expanded-container" Elevation="2">
            <div class="expanded-header">
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Size="Size.Small"
                               Class="close-button"
                               OnClick="@HandleToggle"/>
            </div>

            <div class="expanded-workspaces">
                @foreach (var workspace in Workspaces)
                {
                    <MudTooltip Text="@workspace.Name" Placement="Placement.Right" Arrow="true">
                        <MudButton OnClick="@(() => HandleWorkspaceClick(workspace))"
                                   Class="pa-0 ma-0 workspace-button">
                            <MudPaper Class="workspace-item-mini" Elevation="0"
                                      Style="@($"background-color: {workspace.BackgroundColor}")">
                                @{
                                    var wsIcon = workspace.GetIcon();
                                    if (wsIcon.Type != IconType.SystemDefault)
                                    {
                                        //TODO add the case when it is not svg but some other type which is not supported by MudIcon. In that case use MudImage
                                        <AsyncIcon IconPath="@icon.Path"
                                                   Class="workspace-icon-expanded"
                                                   Title="@workspace.Name"/>
                                    }
                                    else
                                    {
                                        <div class="workspace-placeholder"
                                             style="background-color: @workspace.BackgroundColor;">
                                            <span class="workspace-initial-mini">@workspace.Name[..1]</span>
                                        </div>
                                    }
                                }
                            </MudPaper>
                        </MudButton>
                    </MudTooltip>
                }
            </div>
        </MudPaper>
    }
</div>

@code {
    [Parameter] public WorkspaceFolder Folder { get; set; } = default!;
    [Parameter] public bool IsExpanded { get; set; }
    [Parameter] public EventCallback<WorkspaceFolder> OnFolderToggle { get; set; }
    [Parameter] public EventCallback<Workspace> OnWorkspaceClick { get; set; }
    [Parameter] public EventCallback<WorkspaceFolder> OnSidebarOpen { get; set; }

    private bool isExpanded;
    private IconInfo icon;
    private ImmutableList<Workspace> Workspaces => Folder.Workspaces;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        icon = Folder.GetIcon();

        // Handle expansion based on the folder type
        if (Folder.Type != WorkspaceFolder.FolderType.DROPDOWN)
            isExpanded = IsExpanded;
    }

    private async Task HandleToggle()
    {
        switch (Folder.Type)
        {
            case WorkspaceFolder.FolderType.DROPDOWN:
                isExpanded = !isExpanded;
                await OnFolderToggle.InvokeAsync(Folder);
                break;

            case WorkspaceFolder.FolderType.DROPDOWN_COLLAPSABLE:
                isExpanded = !isExpanded;
                if (isExpanded) await OnFolderToggle.InvokeAsync(Folder); //don't notify on close
                break;

            case WorkspaceFolder.FolderType.SIDEBAR:
            default:
                await HandleSidebarOpen();
                await OnFolderToggle.InvokeAsync(Folder);
                break;
        }
    }

    private async Task HandleWorkspaceClick(Workspace workspace)
    {
        await OnWorkspaceClick.InvokeAsync(workspace);
    }

    private async Task HandleSidebarOpen()
    {
        await OnSidebarOpen.InvokeAsync(Folder);
    }

}

<style>
    .folder-wrapper {
        width: 56px;
    }

    .folder-item {
        border-radius: 50%;
        background-color: #5865f2;
        transition: border-radius 0.2s;
        cursor: pointer;
    }

    .folder-item:hover {
        border-radius: 16px;
    }

    .folder-icon {
        width: 40px;
        height: 40px;
        object-fit: contain;
        border-radius: 8px;
    }

    .folder-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 1fr 1fr;
        gap: 2px;
        width: 40px;
        height: 40px;
    }

    .workspace-icon-mini {
        width: 18px;
        height: 18px;
        object-fit: contain;
        border-radius: 4px;
    }

    .workspace-placeholder {
        width: 18px;
        height: 18px;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .workspace-initial-mini {
        color: white;
        font-size: 8px;
        font-weight: 600;
        text-transform: uppercase;
    }

    /* Expanded container styles */
    .expanded-container {
        background-color: #313338;
        border-radius: 8px;
        padding: 4px;
        width: 56px;
        border: 1px solid #1e1f22;
        transition: all 0.2s ease-out;
    }

    .expanded-header {
        display: flex;
        justify-content: flex-end;
        padding: 2px;
        margin-bottom: 4px;
        border-bottom: 1px solid #1e1f22;
    }

    .close-button {
        color: #b5bac1;
        padding: 0;
        width: 18px;
        height: 18px;
    }

    .close-button:hover {
        color: #ffffff;
        background-color: rgba(255, 255, 255, 0.1);
        border-radius: 4px;
    }

    .expanded-workspaces {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 2px;
        max-height: 400px;
        overflow-y: auto;
        overflow-x: hidden;
    }

    .workspace-button {
        width: 100%;
    }

    .workspace-item-mini {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        cursor: pointer;
    }

    .workspace-item-mini:hover {
        border-radius: 12px;
        transform: scale(1.05);
    }

    .workspace-icon-expanded {
        width: 28px;
        height: 28px;
        object-fit: contain;
    }

    .workspace-initial {
        color: white;
        font-weight: 600;
        font-size: 14px;
        text-transform: uppercase;
    }

    /* Scrollbar for expanded workspaces */
    .expanded-workspaces::-webkit-scrollbar {
        width: 2px;
    }

    .expanded-workspaces::-webkit-scrollbar-track {
        background: transparent;
    }

    .expanded-workspaces::-webkit-scrollbar-thumb {
        background: #1e1f22;
        border-radius: 1px;
    }
</style>
