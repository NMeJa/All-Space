@inject Data.Services.IIconService IconService
@switch (Folder.Type)
{
    case WorkspaceFolder.FolderType.DROPDOWN_COLLAPSABLE:
        <div>COL</div>
        break;
    case WorkspaceFolder.FolderType.DROPDOWN:
        <div>DRO</div>
        break;
    case WorkspaceFolder.FolderType.SIDEBAR:
    default:
        <div>SID</div>
        break;
}
<div class="folder-wrapper flex-shrink-0">
    @if (!IsExpanded || Folder.Type == WorkspaceFolder.FolderType.SIDEBAR)
    {
        <!-- Collapsed folder view -->
        <MudContainer Class="ma-0" Fixed="true" Gutters="false">
            <MudButton OnClick="@HandleToggle" Class="pa-0 ma-0">
                <MudPaper Class="pa-2 folder-item" Elevation="0"
                          Width="55" Height="55">
                    @if (icon.Type != IconType.SystemDefault)
                    {
                        //TODO add the case when it is not svg but some other type which is not supported by MudIcon. In that case use MudImage
                        <AsyncIcon IconPath="@icon.Path"
                                   Class="folder-icon"
                                   Title="@Folder.Name"/>
                    }
                    else
                    {
                        <!-- Grid showing workspace icons -->
                        <div Class="folder-grid">
                            @foreach (var workspace in Workspaces.Take(4))
                            {
                                var wsIcon = workspace.GetIcon();
                                if (wsIcon.Type != IconType.SystemDefault)
                                {
                                    //TODO add the case when it is not svg but some other type which is not supported by MudIcon. In that case use MudImage
                                    <AsyncIcon IconPath="@icon.Path"
                                               Class="workspace-icon-mini"
                                               Title="@workspace.Name"/>
                                }
                                else
                                {
                                    <div class="workspace-placeholder"
                                         style="background-color: @workspace.BackgroundColor;">
                                        <span class="workspace-initial-mini">@workspace.Name[..1]</span>
                                    </div>
                                }
                            }
                        </div>
                    }
                </MudPaper>
            </MudButton>
        </MudContainer>
    }
    else if (Folder.Type is WorkspaceFolder.FolderType.DROPDOWN or
                            WorkspaceFolder.FolderType.DROPDOWN_COLLAPSABLE)
    {
        <!-- Expanded folder showing workspaces -->
        <MudPaper Class="expanded-container" Elevation="2">
            <div class="expanded-header">
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Size="Size.Small"
                               Class="close-button"
                               OnClick="@HandleToggle"/>
            </div>

            <div class="expanded-workspaces">
                @foreach (var workspace in Workspaces)
                {
                    <MudTooltip Text="@workspace.Name" Placement="Placement.Right" Arrow="true">
                        <MudButton OnClick="@(() => HandleWorkspaceClick(workspace))"
                                   Class="pa-0 ma-0 workspace-button">
                            <MudPaper Class="workspace-item-mini" Elevation="0"
                                      Style="@($"background-color: {workspace.BackgroundColor}")">
                                @{
                                    var wsIcon = workspace.GetIcon();
                                    if (wsIcon.Type != IconType.SystemDefault)
                                    {
                                        //TODO add the case when it is not svg but some other type which is not supported by MudIcon. In that case use MudImage
                                        <AsyncIcon IconPath="@icon.Path"
                                                   Class="workspace-icon-expanded"
                                                   Title="@workspace.Name"/>
                                    }
                                    else
                                    {
                                        <div class="workspace-placeholder"
                                             style="background-color: @workspace.BackgroundColor;">
                                            <span class="workspace-initial-mini">@workspace.Name[..1]</span>
                                        </div>
                                    }
                                }
                            </MudPaper>
                        </MudButton>
                    </MudTooltip>
                }
            </div>
        </MudPaper>
    }
</div>

@code {
    [Parameter] public WorkspaceFolder Folder { get; set; } = default!;
    [Parameter] public bool IsExpanded { get; set; }
    [Parameter] public EventCallback<WorkspaceFolder> OnFolderToggle { get; set; }
    [Parameter] public EventCallback<Workspace> OnWorkspaceClick { get; set; }

    private IconInfo icon;
    private ImmutableList<Workspace> Workspaces => Folder.Workspaces;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        icon = Folder.GetIcon();
    }

    private async Task HandleToggle()
    {
        await OnFolderToggle.InvokeAsync(Folder);
    }

    private async Task HandleWorkspaceClick(Workspace workspace)
    {
        await OnWorkspaceClick.InvokeAsync(workspace);
    }

}
