<div class="folder-wrapper flex-shrink-0">
    @if (!isExpanded)
    {
        <!-- Collapsed folder view -->
        <MudContainer Class="ma-0" Fixed="true" Gutters="false">
            <MudButton OnClick="@HandleToggle" Class="pa-0 ma-0">
                <MudPaper Class="pa-2 folder-item" Elevation="0"
                          Width="55" Height="55">
                    <div Class="folder-grid">
                        @foreach (var app in Apps.Take(4))
                        {
                            <div class="app-icon font-monospace d-flex rounded-circle align-items-center justify-content-center"
                                 style="background-color: @app.Color;">
                                @if (!string.IsNullOrEmpty(app.Icon))
                                {
                                    <span class="app-emoji">@app.Icon</span>
                                }
                            </div>
                        }
                    </div>
                </MudPaper>
            </MudButton>
        </MudContainer>
    }
    @* ReSharper disable once ConvertIfStatementToSwitchStatement *@
    else if (Folder.Type == WorkspaceFolder.FolderType.DROPDOWN)
    {
        <!-- Expanded DROPDOWN folder view with workspace items -->
        <MudPaper Class="expanded-container" Elevation="2">
            <!-- Header with close button -->
            <div class="expanded-header">
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Size="Size.Small"
                               Class="close-button"
                               OnClick="@HandleToggle"/>
            </div>

            <!-- Workspace items from apps -->
            <div class="expanded-apps">
                @foreach (var app in Apps)
                {
                    <!-- Convert each app to a workspace-like item -->
                    <MudTooltip Text="@app.Name" Placement="Placement.Right" Arrow="true">
                        <MudButton OnClick="@(() => HandleAppClick(app))"
                                   Class="pa-0 ma-0 app-button">
                            <MudPaper Class="workspace-item-mini" Elevation="0"
                                      Style="@($"background-color: {app.Color}")">
                                @if (!string.IsNullOrEmpty(app.Icon))
                                {
                                    <span class="workspace-emoji-mini">@app.Icon</span>
                                }
                                else
                                {
                                    <span class="workspace-initial">@app.Name[0]</span>
                                }
                            </MudPaper>
                        </MudButton>
                    </MudTooltip>
                }
            </div>
        </MudPaper>
    }
    else if (Folder.Type == WorkspaceFolder.FolderType.SIDEBAR)
    {
        <!-- SIDEBAR type - show indicator to open new sidebar -->
        <MudPaper Class="sidebar-folder-indicator" Elevation="1">
            <MudTooltip Text="@($"Open {Folder.Name} sidebar")" Placement="Placement.Right">
                <MudButton OnClick="@HandleSidebarOpen" Class="pa-0 ma-0 sidebar-button">
                    <div class="sidebar-icon-container">
                        <MudIcon Icon="@Icons.Material.Filled.ArrowForwardIos"
                                 Class="sidebar-arrow"
                                 Size="Size.Small"/>
                        <div Class="folder-grid-mini">
                            @foreach (var app in Apps.Take(4))
                            {
                                <div class="app-icon-mini"
                                     style="background-color: @app.Color;">
                                    @if (!string.IsNullOrEmpty(app.Icon))
                                    {
                                        <span class="app-emoji-mini">@app.Icon</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </MudButton>
            </MudTooltip>
        </MudPaper>
    }
    }
</div>

@code {
    [Parameter] public WorkspaceFolder Folder { get; set; } = default!;
    [Parameter] public bool IsExpanded { get; set; }
    [Parameter] public EventCallback<WorkspaceFolder> OnFolderToggle { get; set; }
    [Parameter] public EventCallback<AppInfo> OnAppClick { get; set; }
    [Parameter] public EventCallback<WorkspaceFolder> OnSidebarOpen { get; set; }

    private bool isExpanded;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        // Only allow expansion for a DROPDOWN type
        if (Folder.Type == WorkspaceFolder.FolderType.SIDEBAR)
            isExpanded = IsExpanded;
    }

    private ImmutableList<AppInfo> Apps => Folder.Apps;

    private async Task HandleToggle()
    {
        if (Folder.Type == WorkspaceFolder.FolderType.DROPDOWN)
        {
            isExpanded = !isExpanded;
            await OnFolderToggle.InvokeAsync(Folder);
        }
        else if (Folder.Type == WorkspaceFolder.FolderType.SIDEBAR)
        {
            await HandleSidebarOpen();
        }
    }

    private async Task HandleAppClick(AppInfo app)
    {
        await OnAppClick.InvokeAsync(app);
    }

    private async Task HandleSidebarOpen()
    {
        await OnSidebarOpen.InvokeAsync(Folder);
    }

}

<style>
    .folder-wrapper {
        width: 56px;
    }

    .folder-item {
        border-radius: 50%;
        background-color: #5865f2;
        transition: border-radius 0.2s;
        cursor: pointer;
    }

    .folder-item:hover {
        border-radius: 16px;
    }

    .folder-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 1fr 1fr;
        gap: 2px;
        width: 40px;
        height: 40px;
    }

    .app-icon {
        font-size: 10px;
    }

    .app-emoji {
        font-size: 10px;
        line-height: 1;
    }

    /* Expanded container styles */
    .expanded-container {
        background-color: #313338;
        border-radius: 8px;
        padding: 4px;
        width: 56px;
        border: 1px solid #1e1f22;
        transition: all 0.2s ease-out;
    }

    .expanded-header {
        display: flex;
        justify-content: flex-end;
        padding: 2px;
        margin-bottom: 4px;
        border-bottom: 1px solid #1e1f22;
    }

    .close-button {
        color: #b5bac1;
        padding: 0;
        width: 18px;
        height: 18px;
    }

    .close-button:hover {
        color: #ffffff;
        background-color: rgba(255, 255, 255, 0.1);
        border-radius: 4px;
    }

    .expanded-apps {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 2px;
        max-height: 400px;
        overflow-y: auto;
        overflow-x: hidden;
    }

    /* Workspace-like items in expanded dropdown */
    .workspace-item-mini {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        cursor: pointer;
    }

    .workspace-item-mini:hover {
        border-radius: 12px;
        transform: scale(1.05);
    }

    .workspace-emoji-mini {
        font-size: 20px;
        line-height: 1;
    }

    .workspace-initial {
        color: white;
        font-weight: 600;
        font-size: 14px;
        text-transform: uppercase;
    }

    /* Sidebar folder indicator styles */
    .sidebar-folder-indicator {
        width: 56px;
        height: 56px;
        background-color: #313338;
        border-radius: 16px;
        border: 2px solid #5865f2;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }

    .sidebar-folder-indicator:hover {
        background-color: #3f4147;
        border-color: #7983f5;
    }

    .sidebar-button {
        width: 100%;
        height: 100%;
    }

    .sidebar-icon-container {
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .sidebar-arrow {
        position: absolute;
        right: 2px;
        color: #5865f2;
        animation: pulse 2s infinite;
    }

    .folder-grid-mini {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 1fr 1fr;
        gap: 1px;
        width: 30px;
        height: 30px;
    }

    .app-icon-mini {
        border-radius: 2px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .app-emoji-mini {
        font-size: 8px;
        line-height: 1;
    }

    /* Scrollbar for expanded apps */
    .expanded-apps::-webkit-scrollbar {
        width: 2px;
    }

    .expanded-apps::-webkit-scrollbar-track {
        background: transparent;
    }

    .expanded-apps::-webkit-scrollbar-thumb {
        background: #1e1f22;
        border-radius: 1px;
    }

    .app-button {
        width: 100%;
    }
</style>
