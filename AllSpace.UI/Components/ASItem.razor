<MudContainer Class="ma-0 flex-shrink-0" Fixed="true" Gutters="false">
    <MudButton OnClick="@HandleClick" Class="pa-0">
        <MudPaper Class="@GetWorkspaceClass()" Elevation="0" Width="55" Height="55">
            @if (!string.IsNullOrEmpty(Workspace.ImageUrl))
            {
                <MudAvatar Image="@Workspace.ImageUrl" Size="Size.Large" Class="workspace-avatar"/>
            }
            else if (!string.IsNullOrEmpty(Workspace.Icon))
            {
                <span class="workspace-emoji">@Workspace.Icon</span>
            }
            else
            {
                <MudText Typo="Typo.h6" Style="color: white;">@Workspace.Name.Substring(0, 1)</MudText>
            }
        </MudPaper>
    </MudButton>
</MudContainer>

@code {
    [Parameter] public Workspace Workspace { get; set; } = default!;
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private string GetWorkspaceClass()
    {
        return "workspace-item" + (IsActive ? " active" : string.Empty);
    }

    private async Task HandleClick()
    {
        await OnClick.InvokeAsync();
    }

}

<!--suppress CssUnusedSymbol -->
<style>

    .workspace-item {
        width: 55px;
        height: 55px;
        border-radius: 50%;
        cursor: pointer;
        transition: border-radius 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        /*background-color: v-bind('Workspace.BackgroundColor');*/
    }

    .workspace-item:hover {
        border-radius: 16px;
    }

    .workspace-item.active {
        border-radius: 16px;
        background-color: #007bff;
    }

    .workspace-avatar {
        width: 55px;
        height: 55px;
    }

    .workspace-emoji {
        font-size: 40px;
        line-height: 1;
    }
</style>
