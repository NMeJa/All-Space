<div class="item-container">
    @if (IsActive)
    {
        <div class="active-indicator"></div>
    }
    <MudPaper Class="@GetWorkspaceClass()" Elevation="0" @onclick="OnClick">
        @if (!string.IsNullOrEmpty(Workspace.ImageUrl))
        {
            <MudAvatar Image="@Workspace.ImageUrl" Size="Size.Large"/>
        }
        else if (!string.IsNullOrEmpty(Workspace.Icon))
        {
            <MudIcon Icon="@Workspace.Icon" Style="color: white; font-size: 24px;"/>
        }
        else
        {
            <MudText Typo="Typo.h6" Style="color: white;">@Workspace.Name.Substring(0, 1)</MudText>
        }
    </MudPaper>
</div>

@code {
    [Parameter] public WorkspaceInfo Workspace { get; set; } = default!;
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private string GetWorkspaceClass()
    {
        return IsActive ? "workspace-item active" : "workspace-item";
    }

}

<style>
    .item-container {
        position: relative;
        width: 56px;
        height: 56px;
    }

    .active-indicator {
        position: absolute;
        left: -12px;
        top: 8px;
        width: 4px;
        height: 40px;
        background-color: white;
        border-radius: 0 4px 4px 0;
    }

    .item {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background-color: #ea4335;
        cursor: pointer;
        transition: border-radius 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .item:hover {
        border-radius: 16px;
    }

    .item.active {
        border-radius: 16px;
    }

</style>