@inherits LayoutComponentBase
@implements IDisposable

<MudLayout>
    <div class="app-container-grid @GetGridClass()">
        <div class="sidebar-area">
            <MudStack Row="@IsHorizontalLayout" Reverse="@IsReverse" Spacing="1">
                @foreach (var (barFolder, i) in sidebars.Select((value, i) => (value, i)))
                {
                    var index = sidebars.Count - i - 1;
                    var sidebarId = GetSidebarId(barFolder, index);
                    var state = GetOrCreateSidebarState(sidebarId);

                    <ASSidebar @key="@sidebarId"
                               IsHorizontal="@IsHorizontalLayout"
                               SidebarId="@sidebarId"
                               State="@state"
                               NestingOrder="@index"
                               Folder="@barFolder"
                               ActiveWorkspaceId="@activeWorkspaceId"
                               OnWorkspaceClick="ChangeWorkspace"
                               OnAddWorkspace="AddWorkspace"
                               OnSidebarFolderOpen="AddSidebar"
                               OnStateChanged="@(newState => UpdateSidebarState(sidebarId, newState))"/>
                }
            </MudStack>
        </div>
        <div class="webview-area">
            <ASWebview ActiveWorkspace="@activeWorkspace"
                       ActiveWorkspaceId="@activeWorkspaceId"/>
        </div>
    </div>
</MudLayout>

@code {
    private Direction direction = Direction.UP;
    private bool IsHorizontalLayout => direction is Direction.UP or Direction.DOWN;
    private bool IsReverse => direction is Direction.LEFT or Direction.UP;

    private string GetGridClass()
    {
        return $"layout-{direction.ToString().ToLower()}";
    }

    private enum Direction
    {
        LEFT,
        RIGHT,
        UP,
        DOWN
    }

}

<style>
    .app-container-grid {
        display: grid;
        width: 100%;
        height: 100vh;
    }

    /* LEFT: Sidebar | Webview */
    .layout-left {
        grid-template-columns: auto 1fr;
        grid-template-areas: "sidebar webview";
    }

    /* RIGHT: Webview | Sidebar */
    .layout-right {
        grid-template-columns: 1fr auto;
        grid-template-areas: "webview sidebar";
    }

    /* UP: Sidebar on top */
    .layout-up {
        grid-template-rows: auto 1fr;
        grid-template-areas: 
            "sidebar"
            "webview";
    }

    /* DOWN: Sidebar on bottom */
    .layout-down {
        grid-template-rows: 1fr auto;
        grid-template-areas: 
            "webview"
            "sidebar";
    }

    .sidebar-area {
        grid-area: sidebar;
    }

    .webview-area {
        grid-area: webview;
    }
</style>
