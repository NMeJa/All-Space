@inherits LayoutComponentBase
@implements IDisposable
<BitButton>Button</BitButton>
<BitDropdown Label="Direction" Items="GetDirections()" DefaultValue="Direction.DOWN" @bind-Value="direction" Class="sidebar-area"/>
<BitToggle Label="Hide Nav Panel" @bind-Value="Hide"/>
@* <BitIcon Icon="@("fas fa-solid fa-house")"></BitIcon> *@

@* <BitLayout HideNavPanel="Hide" ReverseNavPanel="IsReverse"> *@
@*     <NavPanel> *@
@*         <BitStack Horizontal="IsHorizontalLayout" Reversed="IsReverse"> *@
@*             <BitNavBar Items="items"></BitNavBar> *@
@*             $1$ @foreach (var (barFolder, i) in sidebars.Select((value, i) => (value, i))) #1# *@
@*             $1$ { #1# *@
@*             $1$     var index = sidebars.Count - i - 1; #1# *@
@*             $1$     var sidebarId = GetSidebarId(barFolder, index); #1# *@
@*             $1$     var state = GetOrCreateSidebarState(sidebarId); #1# *@
@*             $1$ #1# *@
@*             $1$     <ASSidebar @key="@sidebarId" #1# *@
@*             $1$                IsHorizontal="@IsHorizontalLayout" #1# *@
@*             $1$                SidebarId="@sidebarId" #1# *@
@*             $1$                State="@state" #1# *@
@*             $1$                NestingOrder="@index" #1# *@
@*             $1$                Folder="@barFolder" #1# *@
@*             $1$                ActiveWorkspaceId="@activeWorkspaceId" #1# *@
@*             $1$                OnWorkspaceClick="ChangeWorkspace" #1# *@
@*             $1$                OnAddWorkspace="AddWorkspace" #1# *@
@*             $1$                OnSidebarFolderOpen="AddSidebar" #1# *@
@*             $1$                OnStateChanged="@(newState => UpdateSidebarState(sidebarId, newState))"/> #1# *@
@*             $1$ } #1# *@
@*         </BitStack> *@
@*     </NavPanel> *@
@*     <Main> *@
@*         $1$ <div class="app-container-grid @GetGridClass()"> #1# *@
@*         $1$     <div class="webview-area"> #1# *@
@*         $1$         $2$ <ASWebview ActiveWorkspace="@activeWorkspace" #2# #1# *@
@*         $1$         $2$            ActiveWorkspaceId="@activeWorkspaceId"/> #2# #1# *@
@*         $1$     </div> #1# *@
@*         $1$ #1# *@
@*         $1$ </div> #1# *@
@*     </Main> *@
@* </BitLayout> *@

@code {
    private bool Hide { get; set; } = false;

    private List<BitNavBarItem> items =
    [
        new() { Text = "Home", Class = "fas fa-house" },
        new() { Text = "Products", Title = "asdasd" },
        new() { Text = "Academy", IconName = BitIconName.LearningTools },
        new() { Text = "Profile", IconName = BitIconName.Contact },
    ];

    private Direction direction = Direction.DOWN;
    private bool IsHorizontalLayout => direction is Direction.UP or Direction.DOWN;
    private bool IsReverse => direction is Direction.LEFT or Direction.UP;

    private string GetGridClass()
    {
        return $"layout-{direction.ToString().ToLower()}";
    }

    private enum Direction
    {
        LEFT,
        RIGHT,
        UP,
        DOWN
    }

    private static List<BitDropdownItem<Enum>> GetDirections() => new()
    {
        new() { ItemType = BitDropdownItemType.Header, Text = "Horizontal" },
        new() { Text = "Left", Value = Direction.LEFT },
        new() { Text = "Right", Value = Direction.RIGHT },
        new() { ItemType = BitDropdownItemType.Divider },
        new() { ItemType = BitDropdownItemType.Header, Text = "Vertical" },
        new() { Text = "Up", Value = Direction.UP },
        new() { Text = "Down", Value = Direction.DOWN },
    };

}
