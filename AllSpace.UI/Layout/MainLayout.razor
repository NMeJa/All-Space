@inherits LayoutComponentBase
<MudLayout>
    <div class="app-container">
        <MudStack Row="true" Reverse="true" Spacing="1">
            @foreach (var bar in sidebars)
            {
                <ASSidebar Folders="@bar.Folders.ToList()"
                           Workspaces="@bar.Workspaces.ToList()"
                           ActiveWorkspaceId="@activeWorkspaceId"
                           OnWorkspaceClick="ChangeWorkspace"
                           OnAddWorkspace="AddWorkspace"
                           OnSidebarFolderOpen="AddSidebar"/>
            }
        </MudStack>
        <ASWebview ActiveWorkspace="@activeWorkspace"
                   ActiveWorkspaceId="@activeWorkspaceId"/>
    </div>
</MudLayout>

<style>
    .main-layout {
        padding: 0;
        background-color: #ffffff;
    }

    .app-container {
        display: flex;
        width: 100%;
        height: 100vh;
    }

</style>