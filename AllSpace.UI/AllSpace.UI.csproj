<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ApplicationIcon>favicon.ico</ApplicationIcon>
        <Platforms>AnyCPU</Platforms>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="wwwroot\**"/>
        <Content Update="wwwroot\**">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <ProjectReference Include="..\AllSpace.Core\AllSpace.Core.csproj"/>
        <ProjectReference Include="..\AllSpace.Domain\AllSpace.Domain.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Bit.BlazorUI" Version="10.0.0" />
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.2"/>
        <PackageReference Include="MudBlazor" Version="8.13.0"/>
        <PackageReference Include="Photino.Blazor" Version="4.0.13"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Properties\"/>
    </ItemGroup>

</Project>
